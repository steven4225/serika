{
  "version": 2,
  "projectDirectory": "../var/personal-workspace",
  "authorizedDirectories": [{ "path": "../var/personal-workspace", "access": "readwrite" }],
  "modules": {
    "read-file": { "enabled": true },
    "memory": { "enabled": true, "autoConsolidate": false },
    "checkpoint": { "enabled": true },
    "task": { "enabled": true }
  },
  "fileAuthorizations": [],
  "contextCompaction": {
    "enabled": true,
    "modelContextWindowTokens": 32768,
    "maxOutputTokens": 4096,
    "safetyMarginTokens": 1024,
    "keepRecentTokens": 8192,
    "summaryMaxOutputTokens": 2048
  }
}
