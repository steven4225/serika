{
  "name": "aisdk-agent-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "qq": "pnpm build:runtime && pnpm --filter @aisdk-agent/desktop qq",
    "build": "pnpm build:runtime && pnpm --filter @aisdk-agent/desktop build",
    "build:runtime": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false && pnpm --filter @aisdk-agent/desktop typecheck",
    "test": "pnpm test:runtime && pnpm desktop:test",
    "test:runtime": "pnpm build:runtime && node --test --test-concurrency=4 packages/core/dist/*.test.js packages/core/dist/durable/*.test.js packages/ai-sdk-adapter/dist/*.test.js examples/cli/dist/*.test.js examples/cli/dist/acceptance/*.test.js examples/cli/dist/modules/*.test.js",
    "test:integration": "pnpm build:runtime && node --test --test-concurrency=1 packages/postgres/dist/**/*.integration.test.js",
    "test:all": "pnpm test && pnpm test:integration",
    "db:migrate": "pnpm build:runtime && node packages/postgres/dist/migrate.js up",
    "db:migrate:down": "pnpm build:runtime && node packages/postgres/dist/migrate.js down",
    "demo": "pnpm build:runtime && node examples/cli/dist/index.js",
    "tui": "pnpm build:runtime && node examples/cli/dist/index.js --tui",
    "acceptance": "node examples/cli/dist/acceptance/record.js",
    "eval": "pnpm build:runtime && pnpm --filter @aisdk-agent/eval eval",
    "eval:live": "pnpm build:runtime && pnpm --filter @aisdk-agent/eval eval:live",
    "eval:e2e": "pnpm build:runtime && pnpm --filter @aisdk-agent/eval e2e",
    "eval:guards": "pnpm build:runtime && pnpm --filter @aisdk-agent/eval guards",
    "eval:test": "pnpm build:runtime && pnpm --filter @aisdk-agent/eval test",
    "eval:recall": "pnpm build:runtime && pnpm --filter @aisdk-agent/eval recall",
    "eval:view": "pnpm --filter @aisdk-agent/eval run view",
    "task-worker": "pnpm build:runtime && node examples/cli/dist/task-worker-entry.js",
    "desktop:test": "pnpm build:runtime && pnpm --filter @aisdk-agent/desktop test",
    "desktop:check": "pnpm build:runtime && pnpm --filter @aisdk-agent/desktop check",
    "desktop:dev": "pnpm build:runtime && pnpm --filter @aisdk-agent/desktop dev",
    "desktop:daily": "pnpm --filter @aisdk-agent/desktop daily",
    "desktop:install": "pnpm --filter @aisdk-agent/desktop install:local"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
