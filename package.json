{
  "name": "serika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "manual:cm6": "node apps/desktop/scripts/cm6-manual.mjs",
    "manual:cm6:export": "node apps/desktop/scripts/cm6-manual.mjs --export",
    "manual:cm6:selftest": "pnpm build && node apps/desktop/scripts/cm6-manual-selftest.mjs",
    "build": "pnpm build:runtime && pnpm --filter @serika/desktop build",
    "build:runtime": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false && pnpm --filter @serika/desktop typecheck",
    "test": "pnpm test:runtime && pnpm desktop:test",
    "test:runtime": "pnpm build:runtime && node --test --test-concurrency=4 packages/core/dist/*.test.js packages/ai-sdk-adapter/dist/*.test.js packages/assistant/dist/*.test.js packages/assistant/dist/acceptance/*.test.js packages/assistant/dist/modules/*.test.js apps/cli/dist/*.test.js packages/assistant/scripts/cm-step7-migrate.test.mjs packages/assistant/scripts/home-import.test.mjs",
    "test:all": "pnpm test",
    "demo": "pnpm build:runtime && node apps/cli/dist/index.js",
    "tui": "pnpm build:runtime && node apps/cli/dist/index.js --tui",
    "acceptance": "node packages/assistant/dist/acceptance/record.js",
    "eval": "pnpm build:runtime && pnpm --filter @serika/eval eval",
    "eval:live": "pnpm build:runtime && pnpm --filter @serika/eval eval:live",
    "eval:e2e": "pnpm build:runtime && pnpm --filter @serika/eval e2e",
    "eval:guards": "pnpm build:runtime && pnpm --filter @serika/eval guards",
    "eval:test": "pnpm build:runtime && pnpm --filter @serika/eval test",
    "eval:view": "pnpm --filter @serika/eval run view",
    "task-worker": "pnpm build:runtime && node packages/assistant/dist/task-worker-entry.js",
    "desktop:test": "pnpm build:runtime && pnpm --filter @serika/desktop test",
    "desktop:check": "pnpm build:runtime && pnpm --filter @serika/desktop check",
    "desktop:dev": "pnpm build:runtime && pnpm --filter @serika/desktop dev",
    "desktop:daily": "pnpm --filter @serika/desktop daily",
    "desktop:install": "pnpm --filter @serika/desktop install:local"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
