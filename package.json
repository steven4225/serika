{
  "name": "aisdk-agent-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm build && node --test packages/core/dist/*.test.js packages/core/dist/durable/*.test.js packages/ai-sdk-adapter/dist/*.test.js",
    "test:integration": "pnpm build && node --test --test-concurrency=1 packages/postgres/dist/**/*.integration.test.js",
    "test:all": "pnpm test && pnpm test:integration",
    "db:migrate": "pnpm build && node packages/postgres/dist/migrate.js up",
    "db:migrate:down": "pnpm build && node packages/postgres/dist/migrate.js down",
    "demo": "pnpm build && node examples/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
