{
  "name": "@aisdk-agent/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runloom desktop front end. Consumes createRuntimeApp from the CLI package; contains no runtime logic.",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "tsx --test src/shared/*.test.ts src/main/*.test.ts src/renderer/src/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aisdk-agent/core": "link:../aisdk-agent-framework/packages/core",
    "@aisdk-agent/example-cli": "link:../aisdk-agent-framework/examples/cli",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "ai": "7.0.37",
    "electron": "44.4.5",
    "electron-vite": "5.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
