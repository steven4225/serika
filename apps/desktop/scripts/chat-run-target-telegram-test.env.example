# Copy outside the repository, fill credentials privately, and chmod 600.
SERIKA_TG_TEST_ONLY=1
SERIKA_TG_TEST_BOT_ID=
SERIKA_TG_TEST_OWNER_USER_ID=
SERIKA_TG_TEST_OWNER_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
COMMAND_CODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMAND_CODE_MODEL_ID=deepseek/deepseek-v4.1-flash-fast
COMMAND_CODE_API_KEY=
