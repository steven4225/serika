# SERIKA_TG_TEST_PROFILE_ROOT=/Users/you/.serika-test/chat-run-target-telegram
# SERIKA_TG_TEST_RUNTIME_ROOT=/private/tmp/serika-chat-run-target-telegram-test-runtime
