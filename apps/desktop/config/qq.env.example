# Copy outside the repository and the group workspace; chmod 600.
# This is the OneBot network token, NOT NapCat's WebUI login token.
QQ_CONFIG=/absolute/path/to/qq.json
QQ_ACCESS_TOKEN=

# Independent model configuration. Never copy the entire personal desktop .env.
RUNLOOM_MODEL=deepseek
DEEPSEEK_API_KEY=
# Optional:
# DEEPSEEK_MODEL_ID=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
