{
  "name": "@serika/assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./task-worker-entry": {
      "types": "./dist/task-worker-entry.d.ts",
      "import": "./dist/task-worker-entry.js"
    },
    "./internal/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "dependencies": {
    "@serika/ai-sdk-adapter": "workspace:*",
    "@serika/core": "workspace:*",
    "ai": "7.0.37",
    "saxes": "6.0.0",
    "zod": "4.4.3"
  }
}
